{
  "name": "beautysupply",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Beauty Supply — premium USA beauty landing (Vite + React + Tailwind)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
